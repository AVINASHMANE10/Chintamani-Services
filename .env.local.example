# ============================================
# Shree Chintamani Services - Environment Vars
# ============================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so your secrets stay private.

# Site URL — used for SEO, sitemap, canonical tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (Web3Forms — free, no backend needed)
# Sign up at https://web3forms.com/ → get an access key → paste below
NEXT_PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key-here

# Sanity CMS (for blog — set up later)
# Get these from https://sanity.io/manage after creating a project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# Google Analytics / Tag Manager (optional, add later)
NEXT_PUBLIC_GA_ID=
